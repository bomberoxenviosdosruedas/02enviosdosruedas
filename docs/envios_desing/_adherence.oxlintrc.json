{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/cards/**",
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/layout/**",
              "ui_kits/home/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Anton|Bebas Neue|Outfit))/i]",
        "message": "Font not provided by the design system. Available: Anton, Bebas Neue, Outfit."
      },
      {
        "selector": "JSXOpeningElement[name.name='Accordion'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|defaultOpen|style|key|ref|className|style|children)$/]",
        "message": "<Accordion> doesn't accept that prop. Declared props: items, defaultOpen, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BadgePill'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|pulse|style|key|ref|className|style|children)$/]",
        "message": "<BadgePill> doesn't accept that prop. Declared props: children, tone, pulse, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BadgePill'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:yellow|yellowSoft|blue|ink|glass|white)$/]",
        "message": "<BadgePill> tone must be one of 'yellow' | 'yellowSoft' | 'blue' | 'ink' | 'glass' | 'white'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BentoCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|tag|title|description|items|footer|style|key|ref|className|style|children)$/]",
        "message": "<BentoCard> doesn't accept that prop. Declared props: icon, tag, title, description, items, footer, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|icon|iconRight|block|disabled|as|href|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, icon, iconRight, block, disabled, as, href, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|brand|outline|outlineBlue|secondary|ghost)$/]",
        "message": "<Button> variant must be one of 'default' | 'brand' | 'outline' | 'outlineBlue' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:button|a)$/]",
        "message": "<Button> as must be one of 'button' | 'a'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CtaPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|icon|href|onClick|pulse|style|key|ref|className|style|children)$/]",
        "message": "<CtaPill> doesn't accept that prop. Declared props: children, tone, icon, href, onClick, pulse, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CtaPill'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:yellow|ghost|blue)$/]",
        "message": "<CtaPill> tone must be one of 'yellow' | 'ghost' | 'blue'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|children|style|key|ref|className|style|children)$/]",
        "message": "<FeatureRow> doesn't accept that prop. Declared props: icon, title, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|type|as|placeholder|value|onChange|options|rows|hint|style|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, type, as, placeholder, value, onChange, options, rows, hint, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:input|textarea|select)$/]",
        "message": "<Field> as must be one of 'input' | 'textarea' | 'select'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FloatingPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|children|tone|delay|float|style|key|ref|className|style|children)$/]",
        "message": "<FloatingPill> doesn't accept that prop. Declared props: icon, children, tone, delay, float, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FloatingPill'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:white|yellow|blue)$/]",
        "message": "<FloatingPill> tone must be one of 'white' | 'yellow' | 'blue'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Footer'] > JSXAttribute > JSXIdentifier[name!=/^(?:logoSrc|tagline|about|columns|socials|legal|key|ref|className|style|children)$/]",
        "message": "<Footer> doesn't accept that prop. Declared props: logoSrc, tagline, about, columns, socials, legal."
      },
      {
        "selector": "JSXOpeningElement[name.name='Hero'] > JSXAttribute > JSXIdentifier[name!=/^(?:badge|lines|lead|primaryCta|secondaryCta|trust|counter|counterLabel|mapImage|bgImage|key|ref|className|style|children)$/]",
        "message": "<Hero> doesn't accept that prop. Declared props: badge, lines, lead, primaryCta, secondaryCta, trust, counter, counterLabel, mapImage, bgImage."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|color|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|tone|shadow|animate|style|key|ref|className|style|children)$/]",
        "message": "<IconTile> doesn't accept that prop. Declared props: name, size, tone, shadow, animate, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconTile'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:yellow|glass|tint|blue)$/]",
        "message": "<IconTile> tone must be one of 'yellow' | 'glass' | 'tint' | 'blue'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconTile'] > JSXAttribute[name.name='animate'] > Literal[value!=/^(?:none|tilt|bob)$/]",
        "message": "<IconTile> animate must be one of 'none' | 'tilt' | 'bob'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Marquee'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|duration|tone|separator|style|key|ref|className|style|children)$/]",
        "message": "<Marquee> doesn't accept that prop. Declared props: items, duration, tone, separator, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Marquee'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:dark|yellow|light)$/]",
        "message": "<Marquee> tone must be one of 'dark' | 'yellow' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Modal'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|badge|children|footer|onClose|width|key|ref|className|style|children)$/]",
        "message": "<Modal> doesn't accept that prop. Declared props: open, title, badge, children, footer, onClose, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='Navbar'] > JSXAttribute > JSXIdentifier[name!=/^(?:logoSrc|items|active|onNavigate|scrolled|phone|sticky|key|ref|className|style|children)$/]",
        "message": "<Navbar> doesn't accept that prop. Declared props: logoSrc, items, active, onNavigate, scrolled, phone, sticky."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:badge|badgeTone|title|highlight|lead|align|onDark|underline|style|key|ref|className|style|children)$/]",
        "message": "<SectionHeading> doesn't accept that prop. Declared props: badge, badgeTone, title, highlight, lead, align, onDark, underline, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='badgeTone'] > Literal[value!=/^(?:yellow|yellowSoft|blue|ink|glass|white)$/]",
        "message": "<SectionHeading> badgeTone must be one of 'yellow' | 'yellowSoft' | 'blue' | 'ink' | 'glass' | 'white'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<SectionHeading> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ServiceCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:theme|icon|badge|city|title|description|stats|image|width|height|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ServiceCard> doesn't accept that prop. Declared props: theme, icon, badge, city, title, description, stats, image, width, height, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ServiceCard'] > JSXAttribute[name.name='theme'] > Literal[value!=/^(?:express|lowcost|flex|3pl)$/]",
        "message": "<ServiceCard> theme must be one of 'express' | 'lowcost' | 'flex' | '3pl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SocialCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:network|handle|title|description|cta|href|style|key|ref|className|style|children)$/]",
        "message": "<SocialCard> doesn't accept that prop. Declared props: network, handle, title, description, cta, href, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SocialCard'] > JSXAttribute[name.name='network'] > Literal[value!=/^(?:facebook|instagram|whatsapp)$/]",
        "message": "<SocialCard> network must be one of 'facebook' | 'instagram' | 'whatsapp'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|icon|tag|value|label|style|key|ref|className|style|children)$/]",
        "message": "<StatCard> doesn't accept that prop. Declared props: variant, icon, tag, value, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:hero|tint)$/]",
        "message": "<StatCard> variant must be one of 'hero' | 'tint'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SubscribeForm'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|cta|onSubmit|onDark|style|key|ref|className|style|children)$/]",
        "message": "<SubscribeForm> doesn't accept that prop. Declared props: placeholder, cta, onSubmit, onDark, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:message|show|icon|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: message, show, icon."
      }
    ]
  },
