{
  "color": {
    "signal": {
      "$value": "#FFEC01",
      "$type": "color",
      "$description": "Signal (ex Ember): acento único de acción. CTA primario, estado activo, precio destacado sobre azul, badge urgente, franja de hasta 6px. Siempre con texto #0950F6 encima (4.94:1). Máximo 15 % de la superficie.",
