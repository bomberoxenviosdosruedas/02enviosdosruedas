# ==============================================================================
# .aiexclude — AI Context Exclusion & Token Optimization Standard
# Proyecto: Envíos DosRuedas (2026) | Stack: Next.js 16 · TS · Tailwind v4 · Prisma
# Compatible con: Cursor, Copilot, Windsurf, Cody, JetBrains AI, Gemini, etc.
# ==============================================================================

# ──────────────────────────────────────────────────────────────────────────────
# 1. DEPENDENCIAS Y LOCKFILES (Mayor ahorro de tokens: ~500 KB lockfile)
# ──────────────────────────────────────────────────────────────────────────────
node_modules/
pnpm-lock.yaml
package-lock.json
yarn.lock
bun.lockb
.npmrc
.pnpm-store/

# ──────────────────────────────────────────────────────────────────────────────
# 2. BUILDS Y OUTPUTS DE COMPILACIÓN
# ──────────────────────────────────────────────────────────────────────────────
.next/
dist/
build/
out/
.output/
generated/
docs/paginas_en_txt/*
# TypeScript incremental build cache
tsconfig.tsbuildinfo
*.tsbuildinfo

# Source maps
*.js.map
*.css.map
*.ts.map

# ──────────────────────────────────────────────────────────────────────────────
# 3. CONTROL DE VERSIONES
# ──────────────────────────────────────────────────────────────────────────────
.git/
.gitattributes
.gitmodules
.hg/
.svn/

# ──────────────────────────────────────────────────────────────────────────────
# 4. VARIABLES DE ENTORNO Y SECRETOS (Protección estricta contra filtraciones)
# ──────────────────────────────────────────────────────────────────────────────
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.*.local
*.pem
*.key
*.cert
*.pfx

# Whitelist: esquema de variables de entorno necesario para el agente
!.env.example

# ──────────────────────────────────────────────────────────────────────────────
# 5. CACHÉS DE HERRAMIENTAS Y FRAMEWORKS
# ──────────────────────────────────────────────────────────────────────────────
.turbo/
.parcel-cache/
.eslintcache
.stylelintcache
.vite/
.babel-cache/
.swc/
.pytest_cache/
.ruff_cache/
coverage/
.vercel/

# ──────────────────────────────────────────────────────────────────────────────
# 6. ARCHIVOS BINARIOS, MULTIMEDIA Y FUENTES (Evita consumo innecesario de visión)
# ──────────────────────────────────────────────────────────────────────────────
# Imágenes
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.ico
*.svg
*.avif
*.bmp
*.tiff

# Vectores y diseño
*.psd
*.fig
*.sketch
*.ai
*.xd

# Fuentes
*.woff
*.woff2
*.ttf
*.otf
*.eot

# Documentos no analizables y comprimidos
*.pdf
*.zip
*.tar.gz
*.rar
*.7z

# Video y audio
*.mp4
*.webm
*.mov
*.mp3
*.wav
*.ogg

# ──────────────────────────────────────────────────────────────────────────────
# 7. BINARIOS COMPILADOS Y EJECUTABLES (>14 MB)
# ──────────────────────────────────────────────────────────────────────────────
*.exe
*.dll
*.so
*.dylib
*.bin
*.jar
*.class
*.pyc
*.pyo
__pycache__/

# ──────────────────────────────────────────────────────────────────────────────
# 8. BASES DE DATOS LOCALES, LOGS Y PLANILLAS DE DATOS MASIVAS
# ──────────────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.db
*.sqlite
*.sqlite3
*.sql
*.sql.gz

# Prisma migrations SQL
prisma/migrations/**/*.sql
.prisma/

# Datasets históricos y planillas
enviosdosruedas_datos_2_anos/
*.csv
*.tsv
*.xlsx
*.xls

# ──────────────────────────────────────────────────────────────────────────────
# 9. DIRECTORIOS DE OTROS AGENTES, CACHÉS Y HERRAMIENTAS INTERNAS
# ──────────────────────────────────────────────────────────────────────────────
.hermes/
.opencode/
.agent/
.claude/
.design-sync/
.ds-sync/
.ds-pkg/
ds-bundle/
.impeccable/
.playwright-mcp/
.specify/
.stitch/
.scratch/
scratch/
site/
skills-lock.json

# Exclusiones pesadas dentro de skills
.agents/**/bin/
.agents/**/font-index.json
.agents/**/node_modules/

# ──────────────────────────────────────────────────────────────────────────────
# 10. CONFIGURACIONES DE EDITORES E IDEs
# ──────────────────────────────────────────────────────────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.iml
.history/

# ──────────────────────────────────────────────────────────────────────────────
# 11. DOCUMENTACIÓN PESADA, SCRAPES HTML Y PROMPTS BORRADOR
# ──────────────────────────────────────────────────────────────────────────────
docs/imagenes/
docs/sitio_completo.html
docs/ejemplo_tema.html
docs/prompts/*
docs/prompts_jules.md
docs/refactor-pages-prompt.md
docs/stitch-design-md-prompt.md
docs/stitch-home-prompt.md
docs/public-Feedback-selection.md
docs/diseno/*
docs/contexto/correo_propio/*

# Informes pesados no operativos (>40 KB)
docs/contexto/analisis_correo_argentino.md
docs/contexto/analisis_correo_uruguayo.md
docs/contexto/analisis_envios_dosruedas.md
docs/contexto/analisis_fedex.md
docs/REPORTE_BRAND_AUDIT.md
REPORTE_BRAND_AUDIT.md
document.md
document.html
document.pdf

# ──────────────────────────────────────────────────────────────────────────────
# 12. ARCHIVOS DEL SISTEMA OPERATIVO
# ──────────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.suo
*.swp
*.sln

# ──────────────────────────────────────────────────────────────────────────────
# 13. WHITELIST EXPLÍCITA (Archivos y reglas requeridos para desarrollo asistido)
# ──────────────────────────────────────────────────────────────────────────────
# Configuración
!next.config.ts
!tailwind.config.ts
!tsconfig.json
!package.json
!pnpm-workspace.yaml
!postcss.config.mjs
!eslint.config.mjs
!vitest.config.ts
!prisma.config.ts
!prisma/schema.prisma
!prisma/seed.ts

# Código fuente
!src/**/*
!public/**/manifest.json

# Reglas y especificaciones
!README.md
!AGENTS.md
!DESIGN.md
!PROJECT.md
!CONTEXT.md
!PRODUCT.md
!CLAUDE.md

# Archivos de control IA
!.antigravityignore
!.geminiignore
!.aiexclude

# Skills de agentes
!.agents/skills/**/SKILL.md
!.agents/skills.json
!.agents/rules/**

# Documentación operativa esencial
!docs/knowledge_base/**
!docs/contexto/precios.md
!docs/contexto/arquitectura.md
!docs/contexto/convenciones.md
!docs/contexto/decisiones.md
!docs/contexto/errores-conocidos.md
!docs/contexto/flujo-de-trabajo.md
!docs/contexto/glosario.md
!docs/marketing/glosario.md
!docs/marketing/decisiones.md
!docs/adr/**
!docs/agents/**
!docs/imagenes/hero-derecha/PROMPTS.md
