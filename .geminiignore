# ==============================================================================
# .geminiignore — FinOps & Context Optimization for Google AI / Gemini
# Proyecto: Envíos DosRuedas | Stack: Next.js 16 · TS · Prisma · pnpm · Vitest
# ==============================================================================

# ──────────────────────────────────────────────────────────────────────────────
# 1. SISTEMA OPERATIVO E IDEs
# ──────────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.suo
*.swp
*.sln
*.njsproj
*.ntvs*

# VSCode: ignorar carpetas de usuario pero conservar configuración de proyecto
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

.idea/
*.iml
.history/

# ──────────────────────────────────────────────────────────────────────────────
# 2. DEPENDENCIAS Y LOCK FILES (Mayor ahorro de tokens: ~500 KB lockfile)
# ──────────────────────────────────────────────────────────────────────────────
node_modules/
pnpm-lock.yaml
package-lock.json
yarn.lock
bun.lockb
.npmrc
.pnpm-store/

# ──────────────────────────────────────────────────────────────────────────────
# 3. BUILDS Y OUTPUTS DE COMPILACIÓN
# ──────────────────────────────────────────────────────────────────────────────
.next/
dist/
build/
out/
.output/
generated/

# TypeScript incremental build cache (~570 KB en este proyecto)
tsconfig.tsbuildinfo
*.tsbuildinfo

# Source maps (no aportan al análisis de lógica)
*.js.map
*.css.map
*.ts.map

# ──────────────────────────────────────────────────────────────────────────────
# 4. CACHÉS DE HERRAMIENTAS Y FRAMEWORKS
# ──────────────────────────────────────────────────────────────────────────────
.turbo/
.parcel-cache/
.eslintcache
.stylelintcache
.vite/
.babel-cache/
.swc/
.pytest_cache/
.ruff_cache/
coverage/
.vercel/

# ──────────────────────────────────────────────────────────────────────────────
# 5. VARIABLES DE ENTORNO Y SECRETOS (Nunca deben llegar al contexto IA)
# ──────────────────────────────────────────────────────────────────────────────
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.*.local
*.pem
*.key
*.cert
*.pfx

# Whitelist: el esquema de variables es necesario para que el agente entienda dependencias
!.env.example

# ──────────────────────────────────────────────────────────────────────────────
# 6. ASSETS BINARIOS Y MULTIMEDIA (Evitan consumo de tokens de visión)
# ──────────────────────────────────────────────────────────────────────────────
# Imágenes
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.avif
*.ico
*.bmp
*.tiff
*.svg

# Vectores y diseño
*.psd
*.fig
*.sketch
*.ai
*.xd

# Fuentes
*.woff
*.woff2
*.ttf
*.otf
*.eot

# Documentos y archivos comprimidos
*.pdf
*.zip
*.tar.gz
*.rar
*.7z

# Video y audio
*.mp4
*.webm
*.mov
*.mp3
*.wav
*.ogg

# ──────────────────────────────────────────────────────────────────────────────
# 7. BASES DE DATOS, LOGS Y PLANILLAS DE DATOS PESADAS
# ──────────────────────────────────────────────────────────────────────────────
*.log
*.db
*.sqlite
*.sqlite3
*.sql
*.sql.gz
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Migraciones de Prisma: conservar schema.prisma y seed.ts, ignorar SQL generado
prisma/migrations/**/*.sql
.prisma/

# Exclusión de planillas y datasets masivos
enviosdosruedas_datos_2_anos/
*.csv
*.tsv
*.xlsx
*.xls

# ──────────────────────────────────────────────────────────────────────────────
# 8. BINARIOS COMPILADOS Y HERRAMIENTAS EXTERNAS (>14 MB)
# ──────────────────────────────────────────────────────────────────────────────
*.apk
*.aab
*.ipa
*.jar
*.class
*.pyc
*.pyo
__pycache__/
*.so
*.dylib
*.dll
*.exe
*.bin

# ──────────────────────────────────────────────────────────────────────────────
# 9. DIRECTORIOS DE OTROS AGENTES, CACHÉS Y HERRAMIENTAS INTERNAS
# ──────────────────────────────────────────────────────────────────────────────
.hermes/
.opencode/
.agent/
.claude/
.design-sync/
.ds-sync/
.ds-pkg/
ds-bundle/
.impeccable/
.playwright-mcp/
.specify/
.stitch/
.scratch/
scratch/
site/
skills-lock.json

# Exclusiones pesadas dentro de skills
.agents/**/bin/
.agents/**/font-index.json
.agents/**/node_modules/

# ──────────────────────────────────────────────────────────────────────────────
# 10. DOCS: EXCLUSIONES QUIRÚRGICAS (Mantener solo contexto operativo)
# ──────────────────────────────────────────────────────────────────────────────
docs/imagenes/
docs/sitio_completo.html
docs/ejemplo_tema.html
docs/prompts/*
docs/prompts_jules.md
docs/refactor-pages-prompt.md
docs/stitch-design-md-prompt.md
docs/stitch-home-prompt.md
docs/public-Feedback-selection.md
docs/diseno/*
docs/contexto/correo_propio/*

# Análisis competitivos y auditorías pesadas (>40KB c/u)
docs/contexto/analisis_correo_argentino.md
docs/contexto/analisis_correo_uruguayo.md
docs/contexto/analisis_envios_dosruedas.md
docs/contexto/analisis_fedex.md
docs/REPORTE_BRAND_AUDIT.md
REPORTE_BRAND_AUDIT.md
document.md
document.html
document.pdf

# ──────────────────────────────────────────────────────────────────────────────
# 11. WHITELIST EXPLÍCITA: ARCHIVOS CRÍTICOS QUE SÍ DEBEN VERSE
# ──────────────────────────────────────────────────────────────────────────────
# Configuración del proyecto
!next.config.ts
!tailwind.config.ts
!tsconfig.json
!package.json
!pnpm-workspace.yaml
!postcss.config.mjs
!eslint.config.mjs
!vitest.config.ts
!prisma.config.ts
!prisma/schema.prisma
!prisma/seed.ts

# Código fuente principal
!src/**/*
!public/**/manifest.json

# Documentación de reglas y arquitectura raíz
!README.md
!AGENTS.md
!DESIGN.md
!PROJECT.md
!CONTEXT.md
!PRODUCT.md
!CLAUDE.md

# Archivos de control de contexto IA
!.antigravityignore
!.geminiignore
!.aiexclude

# Skills de agentes
!.agents/skills/**/SKILL.md
!.agents/skills.json
!.agents/rules/**

# Knowledge base y contexto operativo esencial
!docs/knowledge_base/**
!docs/contexto/precios.md              # Fuente de verdad de tarifas 2026
!docs/contexto/arquitectura.md         # Decisiones arquitectónicas
!docs/contexto/convenciones.md         # Convenciones de código
!docs/contexto/decisiones.md           # ADR / decisiones técnicas
!docs/contexto/errores-conocidos.md    # Gotchas y workarounds
!docs/contexto/flujo-de-trabajo.md     # Flujo de desarrollo
!docs/contexto/glosario.md             # Glosario de términos
!docs/marketing/glosario.md            # Vocabulario comercial
!docs/marketing/decisiones.md          # Decisiones de producto
!docs/adr/**                           # Architecture Decision Records
!docs/agents/**                        # Agent issue trackers y guías
!docs/imagenes/hero-derecha/PROMPTS.md # Prompts oficiales para hero
