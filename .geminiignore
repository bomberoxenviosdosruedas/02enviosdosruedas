# ==============================================================================
# .geminiignore — FinOps & Context Optimization for Google AI / Gemini
# Proyecto: Envíos DosRuedas | Stack: Next.js 16 · TS · Prisma · pnpm · Vitest/Playwright
# ==============================================================================

# ──────────────────────────────────────────────────────────────────────────────
# 1. SISTEMA OPERATIVO E IDEs
# ──────────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.suo
*.swp
*.sln
*.njsproj
*.ntvs*

# VSCode: ignorar carpetas de usuario pero conservar configuración de proyecto
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

.idea/
*.iml
.history/

# ──────────────────────────────────────────────────────────────────────────────
# 2. DEPENDENCIAS Y LOCK FILES (mayor ahorro de tokens del proyecto)
# pnpm-lock.yaml pesa ~500 KB — ignorarlo es el mayor win de FinOps
# ──────────────────────────────────────────────────────────────────────────────
node_modules/
pnpm-lock.yaml
package-lock.json
yarn.lock
.npmrc

# ──────────────────────────────────────────────────────────────────────────────
# 3. BUILDS Y OUTPUTS DE COMPILACIÓN
# ──────────────────────────────────────────────────────────────────────────────
.next/
dist/
build/
out/
.output/
generated/

# TypeScript incremental build cache (~570 KB en este proyecto)
tsconfig.tsbuildinfo
*.tsbuildinfo

# ──────────────────────────────────────────────────────────────────────────────
# 4. CACHÉS DE HERRAMIENTAS Y FRAMEWORKS
# ──────────────────────────────────────────────────────────────────────────────
.turbo/
.parcel-cache/
.eslintcache
.stylelintcache
.vite/
.babel-cache/
.swc/
.pytest_cache/
.ruff_cache/
.vercel/
.hermes/

# ──────────────────────────────────────────────────────────────────────────────
# 5. VARIABLES DE ENTORNO Y SECRETOS (nunca deben llegar al contexto IA)
# ──────────────────────────────────────────────────────────────────────────────
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
# Whitelistear el ejemplo: el agente necesita entender la estructura
!.env.example

# ──────────────────────────────────────────────────────────────────────────────
# 6. ASSETS BINARIOS Y MULTIMEDIA (evitan tokens de visión costosos)
# Se excluyen a nivel global; mantener public/manifest.json visible
# ──────────────────────────────────────────────────────────────────────────────

# Imágenes
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.avif
*.ico
*.bmp
*.tiff
*.svg

# Vectores y diseño
*.psd
*.fig
*.sketch
*.ai
*.xd

# Fuentes
*.woff
*.woff2
*.ttf
*.otf
*.eot

# Documentos y archivos comprimidos
*.pdf
*.zip
*.tar.gz
*.rar
*.7z

# Video y audio
*.mp4
*.webm
*.mov
*.mp3
*.wav

# Mapas de source (no aportan al análisis de lógica)
*.js.map
*.css.map
*.ts.map

# ──────────────────────────────────────────────────────────────────────────────
# 7. BASES DE DATOS Y LOGS
# ──────────────────────────────────────────────────────────────────────────────
*.log
*.db
*.sqlite
*.sqlite3
*.sql
*.sql.gz
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Migraciones de Prisma: conservar schema.prisma y seed.ts, ignorar SQL generado
prisma/migrations/**/*.sql

# ──────────────────────────────────────────────────────────────────────────────
# 8. BINARIOS COMPILADOS Y ARCHIVOS DE PLATAFORMA
# ──────────────────────────────────────────────────────────────────────────────
*.apk
*.aab
*.ipa
*.jar
*.class
*.pyc
*.pyo
__pycache__/
*.so
*.dylib
*.dll
*.exe

# ──────────────────────────────────────────────────────────────────────────────
# 9. CARPETAS ESPECÍFICAS DE ESTE PROYECTO QUE NO APORTAN AL CONTEXTO IA
# ──────────────────────────────────────────────────────────────────────────────

# Datos históricos de operaciones (CSV/JSON de operaciones pasadas — muy pesados)
enviosdosruedas_datos_2_anos/

# Carpetas de herramientas internas de IA/agentes (no son código fuente)
.agents/
.claude/
# .gemini/ — NO ignorar: settings.json y commands/ son críticos para el agente
.od-skills/
.specify/
.stitch/
.prisma/

# Carpeta de scratch y sitio de pruebas
scratch/
site/

# Skills lock (metadata de herramientas, no código de la app)
skills-lock.json

# Assets de diseño (no son código ejecutable)
assets/

# ──────────────────────────────────────────────────────────────────────────────
# 10. DOCS: EXCLUSIONES QUIRÚRGICAS (los .md de contexto DEBEN VERSE)
# ──────────────────────────────────────────────────────────────────────────────

# Archivos extremadamente pesados que no aportan texto útil al agente
docs/mapa.svg
docs/imagen_mapa_mdq.png
docs/heroactual.png
docs/Captura de pantalla 2026-07-09 235629.png
docs/tema.json

# HTML de ejemplo y archivos de prompt borrador (no son reglas de arquitectura)
docs/ejemplo_tema.html
docs/prompts_jules.md
docs/refactor-pages-prompt.md
docs/stitch-design-md-prompt.md
docs/stitch-home-prompt.md
docs/public-Feedback-selection.md

# JSON de assets (listas de URLs de imágenes, no lógica de negocio)
docs/imagenes.json
docs/background-image-prompts.md

# Análisis competitivos pesados (>40KB cada uno, no son reglas del proyecto)
docs/contexto/analisis_correo_argentino.md
docs/contexto/analisis_correo_uruguayo.md
docs/contexto/analisis_envios_dosruedas.md
docs/contexto/analisis_fedex.md

# Auditoría de marca (archivo de reporte, no contexto operativo)
docs/REPORTE_BRAND_AUDIT.md
REPORTE_BRAND_AUDIT.md

# ──────────────────────────────────────────────────────────────────────────────
# 11. WHITELIST EXPLÍCITA: ARCHIVOS CRÍTICOS QUE SÍ DEBEN VERSE
# ──────────────────────────────────────────────────────────────────────────────

# Knowledge Base centralizada (nueva)
!docs/knowledge_base/contexto.md

# Contexto operativo esencial
!docs/contexto/precios.md              # Fuente de verdad de tarifas 2026
!docs/contexto/arquitectura.md         # Decisiones arquitectónicas
!docs/contexto/convenciones.md         # Convenciones de código
!docs/contexto/decisiones.md           # ADR / decisiones técnicas
!docs/contexto/errores-conocidos.md    # Gotchas y workarounds
!docs/contexto/flujo-de-trabajo.md     # Flujo de desarrollo
!docs/contexto/glosario.md             # Glosario de términos

# Configuración de proyecto
!next.config.ts
!tailwind.config.ts
!tsconfig.json
!package.json
!pnpm-workspace.yaml
!postcss.config.mjs
!eslint.config.mjs
!vitest.config.ts
!prisma/schema.prisma
!prisma/seed.ts

# Código fuente principal
!src/**/*
!public/**/manifest.json

# Documentación raíz
!README.md
!AGENTS.md
!DESIGN.md
!PROJECT.md
!.aiexclude
!.geminiignore
!.env.examplePantilla_Base_General.md
REPORTE_BRAND_AUDIT.md
docs/REPORTE_BRAND_AUDIT.md
